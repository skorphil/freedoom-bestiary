          "contributorId": "rjy",
          "relation": "Committer (converted to GIF, added symlinks, appended wadinfo.txt)"
        },
        {
          "contributorId": "michael-swanson",
          "relation": "Committer (signed off on commit)"
        }
      ],
      "index": 1,
      "folder": "sprites/wesley",
