      "filePath": "spritesheets/skel.9c6c68127672feee501d5e5cab9d5e15c3dbf8b3.4e8baa89-b50c-4bbb-af2a-11f5e0b77597.webp",
      "commitDate": "2017-07-19T05:18:14.000Z",
      "commitSha": "9c6c68127672feee501d5e5cab9d5e15c3dbf8b3",
      "commitMessage": "Burn all GIFs: Convert everything to PNGs.\nDeuTex 5 now supports these, and we can use real transparency indexes\nin the files too, so no more ugly cyan background!",
      "commitUrl": "https://github.com/freedoom/freedoom/commit/9c6c68127672feee501d5e5cab9d5e15c3dbf8b3",
      "source": "freedoom",
      "sprites": [
        {
          "spriteUrl": "https://github.com/freedoom/freedoom/blob/9c6c68127672feee501d5e5cab9d5e15c3dbf8b3/sprites/skela1d1.png",
          "frame": "A",
          "angle": 1,
          "x": 0,
          "y": 62,
          "width": 77,
          "height": 62,
          "state": "updated",
          "contributions": [
            {
              "contributorId": "michael-swanson",
              "relation": "Committer (PNG conversion commit)"
            }
          ]
