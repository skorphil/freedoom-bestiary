    "b0a6aa39-6c3c-4ec6-a3cf-f24f7362ae4b": {
      "spritesheetId": "b0a6aa39-6c3c-4ec6-a3cf-f24f7362ae4b",
      "fileName": "troo.0181408b25fa534cae5390307dca9beba52769eb.b0a6aa39-6c3c-4ec6-a3cf-f24f7362ae4b.webp",
      "filePath": "spritesheets/troo.0181408b25fa534cae5390307dca9beba52769eb.b0a6aa39-6c3c-4ec6-a3cf-f24f7362ae4b.webp",
      "commitDate": "2012-02-20T16:04:30.000Z",
      "commitSha": "0181408b25fa534cae5390307dca9beba52769eb",
      "commitMessage": "sprites: fix TROO* alignment when flipped (Sodaholic)\nSodaholic writes:\n>Due to the nature of the engine's sprite flipping, the Imp was often\n>misaligned in many rotations, only way to fix it being to add\n>horizontal \"padding\" to the image. So, that's just what I did. With\n>this patch, the Imp will be correctly aligned when being viewed from\n>angles 6-8.\nDW: http://www.doomworld.com/vb/post/1052790\nSigned-off-by: RjY <rjy@users.sourceforge.net>",
      "commitUrl": "https://github.com/freedoom/freedoom/commit/0181408b25fa534cae5390307dca9beba52769eb",
      "source": "freedoom",
      "sprites": [
        {
